{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "macos-arm64",
      "displayName": "macOS ARM64 — Debug, занятия 1.1–1.3",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/project/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-arm64-strict",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/project/build/macos-arm64-strict",
      "cacheVariables": { "NANO_EDR_WERROR": "ON" }
    },
    {
      "name": "macos-arm64-asan",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/project/build/macos-arm64-asan",
      "cacheVariables": { "NANO_EDR_SANITIZE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-arm64-strict", "configurePreset": "macos-arm64-strict" },
    { "name": "macos-arm64-asan", "configurePreset": "macos-arm64-asan" }
  ],
  "testPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "macos-arm64-strict", "configurePreset": "macos-arm64-strict", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "macos-arm64-asan", "configurePreset": "macos-arm64-asan", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
