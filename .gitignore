
# Каталоги сборки студенческого проекта: пресеты кладут их в project/build/.
project/build/

# Копия списка флагов компиляции: её кладёт в корень проекта сборка, чтобы
# clangd нашёл проект без настроек. Файл производный, версионировать нечего.
project/compile_commands.json

# Личный файл пресетов, если кто-то его себе завёл: CMake читает его рядом
# с CMakePresets.json, а версионировать чужие локальные настройки незачем.
project/CMakeUserPresets.json
# Индекс clangd: он кладёт его рядом с compile_commands.json, то есть
# в project/. Каталог производный и вырастает до сотен мегабайт; окно
# VS Code открывается на корне репозитория, и в git status он бы мозолил глаза.
.cache/

# Рабочие настройки редактора: студент создаёт .vscode копированием
# vscode-windows/ или vscode-linux/ под свою систему. Версионируются
# заготовки, а не копия — иначе правка сценария по умолчанию уезжала бы
# в репозиторий и приходила конфликтом при обновлении курса.
.vscode/

# Собранные колоды: tools/render_lecture.py кладёт HTML, PNG и PDF рядом
# со slides.md. Файлы производные — версионируется исходник и картинки
# из lectures/NN/img/, а не результат сборки.
lectures/*/lecture*.html
lectures/*/lecture*.png
lectures/*/lecture*.pdf
lectures/*/slides_export.html
