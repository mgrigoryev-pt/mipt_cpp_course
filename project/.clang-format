# Стиль курса «Программирование на языке C++», ВШПИ МФТИ.
#
# Это описание того, как код в курсе уже написан, а не новая договорённость.
# Основа — Google C++ Style Guide, он же назван кодстайлом курса в CLAUDE.md;
# ниже перечислены все отличия от него, и у каждого есть причина.
#
# Файл лежит в корне симулятора, потому что весь C++ внутреннего репозитория
# лежит под ним. Студенту он уезжает вместе с комплектом — publish.py кладёт
# его в корень project/, и IDE находит его оттуда для всего, что студент пишет
# в src/. Копия на main в решениях синхронизируется рестеком, расхождение
# ловит `python tools/check_style_config.py`.
#
# Два каталога из-под правила выведены своими файлами с DisableFormat:
# include/ (замороженные границы os.h и edr.h — они сверстаны руками, колонками)
# и tests/third_party/ (doctest, чужой код).

Language: Cpp
BasedOnStyle: Google
Standard: Latest

# Отступ 4, а не 2. Google экономит ширину, курс — читаемость на проекторе:
# вложенность в примерах лекций видна с задних рядов.
IndentWidth: 4

# Спецификатор доступа на одну позицию левее тела класса — та же картинка,
# что у Google (` public:` с одним пробелом), просто пересчитанная под отступ 4.
AccessModifierOffset: -3

# Переносы строк оставлены автору. Это не отмена 80 колонок: правило осталось,
# сменился тот, кто его держит, — ровно как строчкой ниже с комментариями.
#
# Замер, из-за которого так: строк длиннее 80 в курсе 0.7%. Остальные
# укладываются, и при ColumnLimit: 80 clang-format переписывает 6.0% строк —
# не потому, что они длинные, а потому, что пакует их плотнее, чем написано.
# Увеличить число не помогает, а вредит вдвойне: при 100 он начинает склеивать
# то, что автор разбил осознанно, и правок становится 8.3%. С ColumnLimit: 0
# остаётся 2.0%, и это уже расхождения, а не разница вкусов.
#
# Разбивка в этом коде несёт смысл: аргументы сгруппированы по назначению,
# формат std::print разрезан по фразам. Форматтеру такое не сообщить.
#
# 80 колонок остаются соглашением курса — код показывают на проекторе
# и цитируют в лекциях. Держится оно теперь так же, как для комментариев:
# автором, а проверяется прогоном tools/check_style_config.py.
#
# Цена известна и одна: при ColumnLimit: 0 clang-format не умеет держать
# перечисление в одной строке. `enum class Severity { kLow, kMedium };` он
# разворачивает по значению на строку, с висящей открывающей скобкой,
# и AllowShortEnumsOnASingleLine на это не влияет — «влезает ли» при нулевом
# лимите не определено. Поэтому перечисления в курсе записаны блоком, и то же
# относится к однострочному телу структуры. Всё остальное однострочное живёт:
# короткие функции, геттеры в теле класса, `if (x) return;`, лямбды, ветки
# switch.
ColumnLimit: 0

# У Google DerivePointerAlignment: true — расположение звёздочки выводится
# из файла. Для учебного кода это плохо: в одном файле `int* p`, в другом
# `int *p`, и студент не понимает, что правильно. Здесь оно задано жёстко.
DerivePointerAlignment: false
PointerAlignment: Left

# Комментарии не переносить. Они здесь плотные, русские и разбиты по смыслу,
# а не по остатку ширины; автоматический перенос ломает ровно это. При
# ColumnLimit: 0 перенос и так не срабатывает, но записано явно: иначе
# возврат ширины форматтеру молча испортил бы каждый комментарий в курсе.
ReflowComments: false

# У Google многострочный литерал всегда начинается с новой строки. Правило
# рассчитано на длинные тексты внутри кода, а попадает здесь по std::print,
# где формат — первый аргумент: перенос уводит вниз весь вызов ради ничего.
# На решениях эта одна строка снимает 146 правок из 229.
AlwaysBreakBeforeMultilineStrings: false

# switch, отображающий значение в значение, читается таблицей:
#
#     case 0: return "process_start";
#
# Так в курсе написаны 34 ветки из 42, и Google-овское false переписывало бы
# их в три строки каждую.
AllowShortCaseLabelsOnASingleLine: true
