# Занятия курса: какой комплект заготовок и какие наборы выданных тестов
# действуют на каждом.
#
# Это справка, а не то, что надо набирать. В сборку передаётся один ключ:
#
#     cmake --preset windows -D NANO_EDR_LESSON=1.3
#
# Всё остальное берётся отсюда.
#
# ---------------------------------------------------------------------------
# Почему наборы не просто накапливаются
# ---------------------------------------------------------------------------
#
# Набор прошлого занятия остаётся подключённым, пока проверяет то, что никуда
# не делось: рефакторинг, задевший чужое, обязан провалить старые тесты сразу,
# а не через три занятия. Поэтому по умолчанию наборы копятся.
#
# Но занятие иногда меняет сам контракт, который старый набор проверял. Тогда
# набор не «устарел» — он проверяет то, чего больше нет, и заменяется новым.
# Каждый такой случай отмечен ниже причиной: это часть содержания занятия,
# а не техническая деталь сборки.

set(NANO_EDR_LESSON_ORDER
    1.1 1.2 1.3
    2.1 2.2 2.3
    3.1 3.2 3.3
    F1 F2 F3)

# ---------------------------------------------------------------------------
# Часть 1. Язык
# ---------------------------------------------------------------------------

set(NANO_EDR_SETS_1.1 1.1)

set(NANO_EDR_SETS_1.2 1.1 1.2)

# Набор 1.1 уходит. Он сравнивал вывод с эталоном подстрочного поиска, а детект
# на занятии 1.3 — другая сущность: не подстрока в строке, а сработавшее
# правило. Проверять новый контракт старым эталоном нечестно, и эталоны
# заменены, а не потеряны.
set(NANO_EDR_SETS_1.3 1.2 1.3)

# ---------------------------------------------------------------------------
# Часть 2. Классы
# ---------------------------------------------------------------------------

# Наборы 1.2 и 1.3 уходят, и против среза l2.1 они бы просто не собрались:
# Event стал классом, разбор отдаёт EventParts вместо Event, список стал
# классом с инвариантом. Проверять новые типы старыми тестами нечем.
set(NANO_EDR_SETS_2.1 2.1)

set(NANO_EDR_SETS_2.2 2.1 2.2)

# Набор 2.2 уходит: его предмет — Condition с переключателем и классы правил
# в том виде, в каком они прожили одно занятие. На 2.3 условия становятся
# полиморфными, а правила — движком.
set(NANO_EDR_SETS_2.3 2.1 2.3)

# ---------------------------------------------------------------------------
# Часть 3. Шаблоны, лямбды, move
# ---------------------------------------------------------------------------

set(NANO_EDR_SETS_3.1 2.1 2.3 3.1)
set(NANO_EDR_SETS_3.2 2.1 2.3 3.1 3.2)
set(NANO_EDR_SETS_3.3 2.1 2.3 3.1 3.2 3.3)

# ---------------------------------------------------------------------------
# Финальная часть
# ---------------------------------------------------------------------------

set(NANO_EDR_SETS_F1 2.1 2.3 3.1 3.2 3.3 F1)
set(NANO_EDR_SETS_F2 2.1 2.3 3.1 3.2 3.3 F1 F2)
set(NANO_EDR_SETS_F3 2.1 2.3 3.1 3.2 3.3 F1 F2 F3)

# ---------------------------------------------------------------------------
# Отдельные файлы, выпадающие из набора 2.1
# ---------------------------------------------------------------------------
#
# Здесь выпадает не набор целиком, а один файл: всё остальное в наборе 2.1
# на этих занятиях нужно ровно так же, как на 2.1.
#
#   list_tests.cpp      с занятия Ф1: односвязный список удалён, окно живёт
#                       на кольцевом буфере. Удалённый тип нельзя проверять.
#   os_handle_tests.cpp с занятия Ф2: конструктор OsHandle стал приватным,
#                       на его место встала фабрика Open с std::expected.
#                       Тесты бросающего конструктора приезжают заменой
#                       в наборе Ф2.

set(NANO_EDR_DROP_EVENT_LIST_FROM         F1)
set(NANO_EDR_DROP_THROWING_OS_HANDLE_FROM F2)

# ---------------------------------------------------------------------------
# Разрешение ключа
# ---------------------------------------------------------------------------

# «Занятие a идёт не раньше занятия b» — по порядку выше.
function(nano_edr_lesson_at_least out lesson since)
    list(FIND NANO_EDR_LESSON_ORDER "${lesson}" at)
    list(FIND NANO_EDR_LESSON_ORDER "${since}" from)
    if(at GREATER_EQUAL 0 AND at GREATER_EQUAL from)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

# Выводит из номера занятия комплект заготовок, наборы тестов и выключатели
# отдельных файлов. Заданное руками не трогает: преподавателю нужно уметь
# собрать комплект против чужого набора, и явный ключ должен выигрывать
# у выведенного.
macro(nano_edr_resolve_lesson lesson)
    list(FIND NANO_EDR_LESSON_ORDER "${lesson}" _nano_edr_at)
    if(_nano_edr_at LESS 0)
        string(REPLACE ";" ", " _nano_edr_known "${NANO_EDR_LESSON_ORDER}")
        message(FATAL_ERROR
            "Нет занятия '${lesson}'. Доступные — ${_nano_edr_known}.")
    endif()

    # Комплект заготовок называется по занятию. На 1.1 его нет: фиксировать
    # ещё нечего, весь код лежит в main.
    if(NOT NANO_EDR_KIT AND NOT "${lesson}" STREQUAL "1.1")
        set(NANO_EDR_KIT "l${lesson}")
    endif()

    if(NOT NANO_EDR_TASKS)
        set(NANO_EDR_TASKS ${NANO_EDR_SETS_${lesson}})
    endif()

    nano_edr_lesson_at_least(_nano_edr_drop_list
                             "${lesson}" "${NANO_EDR_DROP_EVENT_LIST_FROM}")
    if(_nano_edr_drop_list)
        set(NANO_EDR_NO_EVENT_LIST ON)
    endif()

    nano_edr_lesson_at_least(_nano_edr_drop_handle
                             "${lesson}" "${NANO_EDR_DROP_THROWING_OS_HANDLE_FROM}")
    if(_nano_edr_drop_handle)
        set(NANO_EDR_NO_THROWING_OS_HANDLE ON)
    endif()
endmacro()
