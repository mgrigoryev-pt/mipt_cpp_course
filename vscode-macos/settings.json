{
  // Окно открывается на корне репозитория курса, а проект лежит в project/.
  // Этой строкой CMake Tools узнаёт, где CMakeLists.txt, и оттуда же читает
  // CMakePresets.json: второй CMakeLists в корне для этого не нужен.
  "cmake.sourceDirectory": "${workspaceFolder}/project",

  // Агент берёт путь к сценарию относительно текущего каталога, и в постановках
  // занятий команды даны от корня project/. Терминал открывается там же.
  "terminal.integrated.cwd": "${workspaceFolder}/project",

  "cmake.options.statusBarVisibility": "visible",

  // Рабочий каталог и сценарий для запуска через CMake Tools без отладчика
  // (Ctrl+Shift+F5): launch.json он не читает. Под отладчиком запускается
  // по F5 — это CodeLLDB и launch.json, а не эти ключи.
  "cmake.debugConfig": {
    "cwd": "${workspaceFolder}/project",
    "args": ["scenarios/phishing_macro.log"]
  }
}
